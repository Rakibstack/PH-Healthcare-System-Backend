
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Doctor Application Update</title>
</head>

<body
  style="
    margin: 0;
    padding: 0;
    background-color: #f4f7fb;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
  "
>
  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    style="padding: 40px 15px;"
  >
    <tr>
      <td align="center">

        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          style="
            max-width: 600px;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
          "
        >

          <!-- Header -->
          <tr>
            <td
              style="
                background-color: #0f766e;
                padding: 28px 30px;
                text-align: center;
              "
            >
              <h1
                style="
                  margin: 0;
                  color: #ffffff;
                  font-size: 24px;
                "
              >
                PH Healthcare System
              </h1>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 40px 35px;">

              <h2
                style="
                  margin: 0 0 15px;
                  font-size: 22px;
                  color: #111827;
                "
              >
                Update Regarding Your Doctor Application
              </h2>

              <p
                style="
                  margin: 0 0 15px;
                  font-size: 15px;
                  line-height: 1.7;
                "
              >
                Hello <strong><%= name %></strong>,
              </p>

              <p
                style="
                  margin: 0 0 20px;
                  font-size: 15px;
                  line-height: 1.7;
                  color: #4b5563;
                "
              >
                Thank you for your interest in joining
                <strong>PH Healthcare System</strong>.
                After reviewing your application, we are unable to approve
                your doctor application at this time.
              </p>

              <!-- Status Box -->
              <div
                style="
                  background-color: #fef2f2;
                  border: 1px solid #fecaca;
                  border-radius: 10px;
                  padding: 22px;
                  margin: 25px 0;
                "
              >
                <p
                  style="
                    margin: 0 0 8px;
                    font-size: 13px;
                    color: #64748b;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                  "
                >
                  Application Status
                </p>

                <p
                  style="
                    margin: 0;
                    font-size: 22px;
                    font-weight: bold;
                    color: #dc2626;
                  "
                >
                  NOT APPROVED
                </p>
              </div>

              <% if (rejectionReason) { %>

                <div
                  style="
                    background-color: #f8fafc;
                    border-radius: 8px;
                    padding: 18px;
                    margin: 20px 0;
                  "
                >
                  <p
                    style="
                      margin: 0 0 8px;
                      font-size: 14px;
                      font-weight: bold;
                      color: #374151;
                    "
                  >
                    Reason:
                  </p>

                  <p
                    style="
                      margin: 0;
                      font-size: 14px;
                      line-height: 1.7;
                      color: #6b7280;
                    "
                  >
                    <%= rejectionReason %>
                  </p>
                </div>

              <% } %>

              <p
                style="
                  margin: 20px 0 0;
                  font-size: 14px;
                  line-height: 1.7;
                  color: #6b7280;
                "
              >
                If you believe this decision was made in error or you would
                like more information, please contact our support team.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td
              style="
                background-color: #f8fafc;
                padding: 20px 30px;
                text-align: center;
              "
            >
              <p
                style="
                  margin: 0;
                  font-size: 12px;
                  color: #94a3b8;
                "
              >
                © <%= new Date().getFullYear() %> PH Healthcare System.
                All rights reserved.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>
</body>
</html>