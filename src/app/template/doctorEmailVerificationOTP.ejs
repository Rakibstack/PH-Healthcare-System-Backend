
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Verify Your Email</title>
</head>

<body
  style="
    margin: 0;
    padding: 0;
    background-color: #f4f7fb;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
  "
>
  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    style="padding: 40px 15px;"
  >
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          style="
            max-width: 600px;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
          "
        >

          <!-- Header -->
          <tr>
            <td
              style="
                background-color: #0f766e;
                padding: 28px 30px;
                text-align: center;
              "
            >
              <h1
                style="
                  margin: 0;
                  color: #ffffff;
                  font-size: 24px;
                "
              >
                PH Healthcare System
              </h1>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 40px 35px;">

              <h2
                style="
                  margin: 0 0 15px;
                  font-size: 22px;
                  color: #111827;
                "
              >
                Verify Your Email Address
              </h2>

              <p
                style="
                  margin: 0 0 15px;
                  font-size: 15px;
                  line-height: 1.7;
                "
              >
                Hello <strong><%= name %></strong>,
              </p>

              <p
                style="
                  margin: 0 0 25px;
                  font-size: 15px;
                  line-height: 1.7;
                  color: #4b5563;
                "
              >
                Thank you for applying to become a doctor on
                <strong>PH Healthcare System</strong>.
                Please verify your email address using the OTP below.
              </p>

              <!-- OTP Box -->
              <div
                style="
                  text-align: center;
                  background-color: #f0fdfa;
                  border: 1px solid #99f6e4;
                  border-radius: 10px;
                  padding: 25px;
                  margin: 25px 0;
                "
              >
                <p
                  style="
                    margin: 0 0 10px;
                    font-size: 13px;
                    color: #64748b;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                  "
                >
                  Your Verification Code
                </p>

                <div
                  style="
                    font-size: 34px;
                    font-weight: bold;
                    letter-spacing: 8px;
                    color: #0f766e;
                  "
                >
                  <%= otpValue %>
                </div>
              </div>

              <p
                style="
                  margin: 0 0 10px;
                  font-size: 14px;
                  color: #4b5563;
                  line-height: 1.6;
                "
              >
                This OTP will expire in
                <strong><%= expiresIn %> minutes</strong>.
              </p>

              <p
                style="
                  margin: 0;
                  font-size: 14px;
                  color: #6b7280;
                  line-height: 1.6;
                "
              >
                If you did not submit a doctor application, you can safely
                ignore this email.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td
              style="
                background-color: #f8fafc;
                padding: 20px 30px;
                text-align: center;
              "
            >
              <p
                style="
                  margin: 0;
                  font-size: 12px;
                  color: #94a3b8;
                "
              >
                © <%= new Date().getFullYear() %> PH Healthcare System.
                All rights reserved.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>
</body>
</html>